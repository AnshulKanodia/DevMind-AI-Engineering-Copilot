# ==============================================================================
# DevMind — AI Engineering Copilot Environment Configuration Template
# Copy this file to .env and configure values before starting services
# ==============================================================================

# Core Service Configuration
PROJECT_NAME="DevMind"
ENVIRONMENT="development"
DEBUG=true
LOG_LEVEL="INFO"

# API & Security
SECRET_KEY="replace-this-with-a-secure-random-32-byte-hex-string"
ENCRYPTION_KEY="replace-with-a-32-byte-base64-key-for-token-encryption"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
BACKEND_CORS_ORIGINS='["http://localhost:3000", "http://127.0.0.1:3000"]'

# MongoDB Atlas / Local Vector Database
# Local MongoDB Atlas emulator connection string:
MONGODB_URI="mongodb://localhost:27017/devmind?directConnection=true"
# Or cloud Atlas connection string:
# MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.mongodb.net/devmind?retryWrites=true&w=majority"
MONGODB_DB_NAME="devmind"
MONGODB_VECTOR_INDEX_NAME="vector_index"

# Redis Cache & Sessions
REDIS_URL="redis://localhost:6379/0"

# OpenAI LLM & Embedding Settings
OPENAI_API_KEY="sk-proj-your-openai-api-key-here"
OPENAI_MODEL="gpt-4o"
OPENAI_MINI_MODEL="gpt-4o-mini"
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"
OPENAI_EMBEDDING_DIMENSIONS=1536

# GitHub OAuth Integration
GITHUB_CLIENT_ID="your_github_oauth_client_id"
GITHUB_CLIENT_SECRET="your_github_oauth_client_secret"
GITHUB_REDIRECT_URI="http://localhost:3000/auth/callback"

# Observability & LangSmith Tracing
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT="https://api.smith.langchain.com"
LANGCHAIN_API_KEY="lsv2_pt_your_langsmith_api_key_here"
LANGCHAIN_PROJECT="devmind-copilot"

# Ephemeral Sandbox Settings
SANDBOX_TEMP_DIR="/tmp/devmind-sandboxes"
MAX_REPO_SIZE_MB=500
CLONE_TIMEOUT_SECONDS=120
